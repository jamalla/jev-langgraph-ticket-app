# Leave a key empty to use that model's mock.
TYPESAFE_API_KEY=
# Optional: another Jev provider, e.g. OpenCode Zen https://opencode.ai/zen
TYPESAFE_BASE_URL=
# Real LLM: set ONE of these (OpenAI wins if both are set).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JEV_MODEL=jev-latest
# Empty = gpt-5-nano (OpenAI) or claude-haiku-4-5-20251001 (Anthropic).
LLM_MODEL=
# Set to 0 to skip the mock models' sleep (tests do this).
MOCK_DELAY=1
